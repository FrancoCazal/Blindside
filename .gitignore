# --- Datos ---------------------------------------------------------------
# raw/interim/processed NO se commitean. data/sample/ SI (ver checklist M7).
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/sample/
!data/sample/**
# Respaldos y registro del pipeline de actualizacion (`blindside.data.update`).
# Van despues de la excepcion de data/sample/ para que tambien apliquen ahi: la
# muestra commiteada no puede cambiar por correr una ingesta de prueba.
data/incoming/
**/*.prev.parquet
**/.*.tmp
data/sample/update_log.json

# --- Artefactos de modelo ------------------------------------------------
artifacts/*
!artifacts/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
*.onnx

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# --- Entornos ------------------------------------------------------------
.venv/
venv/
env/
.env
.python-version

# --- Herramientas --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Reportes generados --------------------------------------------------
reports/figures/*
!reports/figures/.gitkeep
# Los .md de reports/ SI se commitean: son la evidencia que cita el README. Los
# parquet del detalle no: son decenas de MB, se regeneran con `make models` y en
# git no se pueden leer ni diferenciar.
reports/*.parquet

# --- Editor / OS ---------------------------------------------------------
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
Desktop.ini

# Scratch: scripts y logs de medicion de una sola vez. El prefijo `_` los marca
# como descartables, y tenerlos aca evita que entren a un commit por un `git add -A`
# (ya paso una vez con _r.txt y _ver.py).
_*.py
_*.log
_*.err
_*.txt
_*.ps1
